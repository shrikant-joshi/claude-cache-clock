{
  "description": "Cache Clock: track the main chat's prompt-cache TTL from the API usage receipts. POSIX sh + awk, on macOS, Linux, WSL and Windows (Git Bash).",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/cc.sh\" start", "timeout": 15 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/cc.sh\" prompt", "timeout": 10, "async": true }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/cc.sh\" stop", "timeout": 15 },
          { "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/waiter.sh\"", "asyncRewake": true, "timeout": 7500 }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          { "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/cc.sh\" end", "timeout": 5 }
        ]
      }
    ]
  }
}
